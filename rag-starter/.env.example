# Copy this file to ".env" and paste your key. NEVER commit the real .env file.
#   cp .env.example .env

# Your LLM provider API key (the instructor may provide one for class).
# Leave blank to run fully offline with the FakeLLM / fallback embeddings.
OPENAI_API_KEY=

# Optional overrides (defaults are fine for the course):
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# Week 10 (optional): run chat() against a LOCAL model via Ollama instead.
# Requires Ollama installed and running (ollama.com), plus `ollama pull llama3.2`.
# RIBOT_LLM=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434
