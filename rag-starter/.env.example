# Copy this file to ".env" and paste your key. NEVER commit the real .env file.
#   cp .env.example .env

# Your LLM provider API key (the instructor may provide one for class).
# Leave blank to run fully offline with the FakeLLM / fallback embeddings.
OPENAI_API_KEY=

# Optional overrides (defaults are fine for the course):
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# Week 8 (optional): run chat() and tool calling against a small LOCAL model via Ollama.
# Requires Ollama installed and running (ollama.com), plus `ollama pull qwen3.5:2b`.
# Smaller alternatives: granite4:1b-h, granite4:350m-h. pytest ignores this switch.
# RIBOT_LLM=ollama
# OLLAMA_MODEL=qwen3.5:2b
# OLLAMA_HOST=http://localhost:11434
# Thinking models like qwen3.5 reason before answering. That is off by default because it
# makes a 2B model very slow on a laptop. Set to true to compare speed and answer quality.
# OLLAMA_THINK=false
